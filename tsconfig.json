{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "resolveJsonModule": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types"
    ]
  },
  "exclude": [
    "node_modules",
    ".sites-runtime",
    "examples",
    "dist"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "backend/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "db/schema.ts",
    "vite.config.ts",
    "drizzle.config.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
